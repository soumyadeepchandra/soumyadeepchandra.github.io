@article{chandra2025viper,
  topic={video},
  bibtex_show={true},
  abbr={IEEE Access},
  title={ViPeR: Vision-Based Surgical Phase Recognition},
  author={Chandra, Soumyadeep and Chowdhury, Sayeed Shafayet and Yong, Courtney and Jeng, Ginnie and Mahenthiran, Ashorne and Morris, Kostantinos E. and Love, Harrison L. and Sundaram, Chandru P. and Roy, Kaushik},
  journal={IEEE Access},
  year={2025},
  html={https://ieeexplore.ieee.org/document/11078244/},
  code={https://github.com/soumyadeepchandra/ViPeR},
  abstract={Surgical phase recognition is a critical yet challenging problem, hindered by the scarcity of well-annotated medical datasets and the substantial inter- and intra-procedural variation of surgical workflows. ViPeR is a vision-based model for phase recognition that achieves state-of-the-art performance of 91.7% on Cholec80 and 66.4% on UroSlice, a more challenging dataset with irregular phase durations, non-standardized phase order, and a smaller sample size.}
}

@inproceedings{chowdhury2024opel,
  topic={video},
  bibtex_show={true},
  abbr={NeurIPS},
  title={OPEL: Optimal Transport Guided ProcedurE Learning},
  author={Chowdhury, Sayeed Shafayet and Chandra, Soumyadeep and Roy, Kaushik},
  booktitle={Advances in Neural Information Processing Systems (NeurIPS)},
  year={2024},
  selected={true},
  html={https://neurips.cc/virtual/2024/poster/93812},
  slides={https://neurips.cc/media/neurips-2024/Slides/93812.pdf},
  doi={10.52202/079017-1915},
  abstract={Procedure learning is the task of identifying the key-steps of a task and determining their logical order, given several videos of the same task. OPEL treats video frames as samples from an unknown distribution and frames their distance calculation as an optimal transport problem, relaxing the frame-to-frame and monotonic-alignment assumptions of prior work. Optimality and temporal priors regularize the transport plan. OPEL significantly outperforms the state of the art on both egocentric and third-person procedure-learning benchmarks.}
}

@article{chowdhury2024visual,
  topic={video},
  bibtex_show={true},
  abbr={IEEE Access},
  title={Toward Visual Syntactical Understanding},
  author={Chowdhury, Sayeed Shafayet and Chandra, Soumyadeep and Roy, Kaushik},
  journal={IEEE Access},
  volume={12},
  year={2024},
  doi={10.1109/ACCESS.2024.3397061},
  arxiv={2401.17497},
  abstract={An image can be viewed as a visual "sentence" whose semantic parts act as "words". This work shows that state-of-the-art CNNs and vision transformers fail to discriminate between syntactically correct and incorrect images (e.g., a face with eyes and nose swapped), and proposes an unsupervised three-stage framework — detecting the "words", masking and reconstructing them with a BERT-style masked autoencoder, and comparing original and reconstructed parts — to determine syntactic correctness, reaching 92.10% and 90.89% accuracy on CelebA and AFHQ.}
}

