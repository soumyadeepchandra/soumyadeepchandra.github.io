---
layout: shell
---
{%- assign socials = site.data.socials -%}
<section class="page-hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container">
    <span class="kicker hero-in" style="--d: 0s">Publications</span>
    <h1 class="page-title hero-in" style="--d: .08s">Papers &amp; Preprints</h1>
    <p class="page-lede hero-in" style="--d: .16s">
      Grouped by research area and year. <sup>*</sup> denotes equal contribution.
      {% if socials.scholar_userid %}Citations on <a class="nowrap" href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}" target="_blank" rel="noopener">Google Scholar</a>.{% endif %}
    </p>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    <div class="filters filters--tabs hero-in" style="--d: .24s" role="tablist" aria-label="Research area" data-tabs>
      <span class="filter-pill" aria-hidden="true" data-pill></span>
      <button type="button" class="filter is-active" role="tab" aria-selected="true" data-tab="thermal" id="tab-thermal" aria-controls="panel-thermal">Thermal Modeling &amp; AI for Hardware</button>
      <button type="button" class="filter" role="tab" aria-selected="false" data-tab="video" id="tab-video" aria-controls="panel-video">Video &amp; Scene Understanding</button>
      <button type="button" class="filter" role="tab" aria-selected="false" data-tab="earlier" id="tab-earlier" aria-controls="panel-earlier">Earlier Work</button>
    </div>

    <div class="pubs">
      <div class="tab-panel is-current" role="tabpanel" id="panel-thermal" aria-labelledby="tab-thermal" data-panel="thermal">
        {% bibliography --group_by year --group_order descending --query @*[topic=thermal] --template bib_card %}
      </div>
      <div class="tab-panel" role="tabpanel" id="panel-video" aria-labelledby="tab-video" data-panel="video" hidden>
        {% bibliography --group_by year --group_order descending --query @*[topic=video] --template bib_card %}
      </div>
      <div class="tab-panel" role="tabpanel" id="panel-earlier" aria-labelledby="tab-earlier" data-panel="earlier" hidden>
        {% bibliography --group_by year --group_order descending --query @*[topic=earlier] --template bib_card %}
      </div>
    </div>
  </div>
</section>
