@inproceedings{chandra2026therm3d,
  topic={thermal},
  bibtex_show={true},
  abbr={Under Review},
  title={Therm3D: Physics-Aware Neural Operator for Transient Thermal Modeling in 3D Heterogeneous Integration Systems},
  author={Chandra, Soumyadeep and Chowdhury, Sayeed Shafayet and Roy, Kaushik},
  booktitle={Under review at Design, Automation and Test in Europe (DATE)},
  year={2026},
  selected={true},
  abstract={A physics-informed neural operator framework for near-real-time steady-state and transient thermal analysis of 3D heterogeneous integration (3DHI) systems. An automated COMSOL--Python FEM pipeline generates synthetic training data, and a point-cloud latent neural operator with coordinate-conditioned decoding and multi-stage autoregressive rollout performs long-horizon 3D thermal prediction. Energy conservation, boundary-condition enforcement and source/hotspot-aware modeling improve physical consistency. Therm3D achieves 1.09 °C RMSE on unseen power maps over transient trajectories while running roughly 10,000--20,000x faster than FEM, enabling rapid evaluation of 3DHI power and package configurations.}
}

@article{chandra2025thermal,
  topic={thermal},
  bibtex_show={true},
  abbr={IEEE TCAD},
  title={2D-ThermAl: Physics-Informed Framework for Thermal Analysis of Circuits using Generative AI},
  author={Chandra, Soumyadeep and Chowdhury, Sayeed Shafayet and Roy, Kaushik},
  journal={IEEE Transactions on Computer-Aided Design of Integrated Circuits and Systems (TCAD)},
  year={2025},
  publisher={IEEE},
  selected={true},
  arxiv={2512.01163},
  code={https://github.com/soumyadeepchandra/2D-ThermAl},
  abstract={Thermal analysis is increasingly critical in modern integrated circuits, where non-uniform power dissipation and high transistor densities can cause rapid temperature spikes and reliability concerns. ThermAl is a physics-informed generative AI framework that identifies heat sources and estimates full-chip transient and steady-state thermal distributions directly from input activity profiles. It uses a hybrid U-Net with positional encoding and a physics-aware regularizer, trained on a dataset of 200+ COMSOL-simulated circuit configurations ranging from logic gates to complex designs. ThermAl achieves 0.71 °C RMSE and runs up to ~200x faster than conventional FEM tools, with full-scale error below 2.2% across a 25--95 °C operating range.}
}

